# ===== REQUIRED to boot =====
# Server throws on startup if missing
SUPABASE_DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# ===== AI providers (required for the features that use them) =====
# Gemini is the primary model for text/images/TTS in this codebase
GEMINI_API_KEY=

# OpenAI (used as fallback for text + images via /api/ai/* routes)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Replicate (Flux image generation)
REPLICATE_API_TOKEN=

# ElevenLabs TTS (currently hardcoded in constants.ts — see TODO)
ELEVENLABS_API_KEY=

# ===== Optional =====
# Resend transactional email (for /api/students/send-credentials and SMTP debug routes)
RESEND_API_KEY=

# Replit-style Object Storage (currently disabled in code; leave blank)
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Set to "production" to serve the built client from /dist on port 5000
NODE_ENV=development
